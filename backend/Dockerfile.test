FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends fonts-thai-tlwg libraqm0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements*.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock -r requirements-test.txt
COPY app ./app
COPY migrations ./migrations
COPY tests ./tests
CMD ["sh", "-c", "python -m app.migrate && python -m pytest -q"]
